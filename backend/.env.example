# Deadline Radar — Backend Environment Configuration
# Copy this file to backend/.env and fill in your actual values.
# NEVER commit backend/.env to version control.

# ============================================================
# AI Provider
# ============================================================
# Options: groq | gemini | claude | mock
# "mock" uses a deterministic heuristic estimator (no API key required)
AI_PROVIDER=groq

# ============================================================
# Groq (Primary AI Provider)
# ============================================================
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=
# Current supported models (pick one):
#   llama-3.3-70b-versatile  (recommended — best quality/speed balance)
#   llama-3.1-70b-versatile
#   llama-3.1-8b-instant     (fastest, lower cost)
#   mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=15

# ============================================================
# Gemini (Legacy — retained for backward compatibility)
# ============================================================
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# Database
# ============================================================
# Defaults to local SQLite (zero setup required for development)
DATABASE_URL=sqlite+aiosqlite:///./deadline_radar.db

# ============================================================
# Security
# ============================================================
# Change this in production — generate with: openssl rand -hex 32
SECRET_KEY=deadlineradar_super_secret_dev_key_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# Application
# ============================================================
ENVIRONMENT=development
DEBUG=false
